type AccountIncome implements Node {
  id: ID! @goField(forceResolver: true)
  householdId: ID! @goField(forceResolver: true)
  accountId: ID! @goField(forceResolver: true)
  amountYen: Long!
  currency: String!
  occurredAt: String!
  description: String!
  createdAt: String!
}

type AccountIncomeEdge {
  cursor: String!
  node: AccountIncome!
}

type AccountIncomeConnection {
  edges: [AccountIncomeEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

extend type Query {
  accountIncomes(householdId: ID! @nodeID(of: "Household"), after: String, first: Int = 50): AccountIncomeConnection!
}
