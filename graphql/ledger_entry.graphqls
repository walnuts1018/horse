interface LedgerEntry {
  id: ID!
  occurredAt: String!
  description: String!
  amountYen: Long!
  currency: String!
  createdAt: String!
}

type LedgerEdge {
  cursor: String!
  node: LedgerEntry!
}

type LedgerConnection {
  edges: [LedgerEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

extend type Query {
  ledger(householdId: ID! @nodeID(of: "Household"), after: String, before: String, first: Int, last: Int): LedgerConnection!
}
