{
  "name": "horse-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm relay && vite build",
    "dev": "vite --host 0.0.0.0",
    "e2e": "playwright test --config playwright.config.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:markup": "markuplint 'src/**/*.tsx'",
    "lint:markup:fix": "markuplint --fix 'src/**/*.tsx'",
    "lint:oxlint": "oxlint",
    "lint:oxlint:fix": "oxlint --fix",
    "lint:steiger": "steiger ./src",
    "lint:style": "stylelint 'src/**/*.css'",
    "relay": "node scripts/prepare-relay-schema.mjs && relay-compiler --noWatchman",
    "relay:validate": "node scripts/prepare-relay-schema.mjs && relay-compiler --validate --noWatchman",
    "start": "node .output/server/index.mjs",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006",
    "storybook:build": "storybook build --output-dir .output/storybook",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "graphql": "^17.0.2",
    "idb": "^8.0.4",
    "lucide-react": "1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-relay": "^21.0.1",
    "relay-runtime": "^21.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@markuplint/jsx-parser": "^5.2.0",
    "@markuplint/react-spec": "^5.2.0",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/react-vite": "10.6.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-relay": "^21.0.1",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "markuplint": "^5.2.0",
    "nitro": "3.0.260610-beta",
    "oxfmt": "0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "relay-compiler": "^21.0.1",
    "steiger": "^0.7.0",
    "storybook": "10.6.2",
    "stylelint": "^17.16.0",
    "stylelint-browser-compat": "1.0.0-beta.200",
    "stylelint-config-standard": "^40.0.0",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vitest": "5.0.4"
  }
}
